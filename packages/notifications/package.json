{
  "name": "@slate/notifications",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hexagonal notifications — an EmailProvider port with pluggable adapters (log-only default, noop, smtp, generic http). A bare fork 'sends' to the log.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "@slate/config": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
