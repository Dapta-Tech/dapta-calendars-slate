DTEND:20260803T153000Z
SUMMARY:Intro Call
STATUS:CANCELLED
LOCATION:https://meet.example.test/room-1
URL:https://meet.example.test/room-1
ORGANIZER;CN=Alex Rivera:mailto:alex@example.com
ATTENDEE;CN=Sam Guest;RSVP=TRUE:mailto:sam@example.com
END:VEVENT
END:VCALENDAR
",
