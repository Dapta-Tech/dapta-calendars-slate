        <tr><td style="padding:12px 16px 12px 0;width:72px;vertical-align:top;font-size:13px;line-height:20px;color:#67676f;">When</td><td style="padding:12px 0;vertical-align:top;font-size:15px;line-height:20px;color:#1a1a1c;font-weight:500;">Mon, Aug 3, 11:00 AM EDT</td></tr><tr><td style="border-top:1px solid #e6e6e8;padding:12px 16px 12px 0;width:72px;vertical-align:top;font-size:13px;line-height:20px;color:#67676f;">With</td><td style="border-top:1px solid #e6e6e8;padding:12px 0;vertical-align:top;font-size:15px;line-height:20px;color:#1a1a1c;font-weight:500;">Alex Rivera</td></tr><tr><td style="border-top:1px solid #e6e6e8;padding:12px 16px 12px 0;width:72px;vertical-align:top;font-size:13px;line-height:20px;color:#67676f;">Where</td><td style="border-top:1px solid #e6e6e8;padding:12px 0;vertical-align:top;font-size:15px;line-height:20px;color:#1a1a1c;font-weight:500;">Online meeting</td></tr>
      </table>
      
      
    </td></tr>
