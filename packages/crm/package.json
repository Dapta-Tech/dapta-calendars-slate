{
  "name": "@slate/crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CrmProvider port + the HubSpot adapter. Open core and vendor-named by ADR 0001 (R15 governs calendar vendors only). Pure HTTP: no DB, no encryption key.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mapping": {
      "types": "./dist/mapping.d.ts",
      "import": "./dist/mapping.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slate/types": "workspace:*"
  },
  "devDependencies": {
    "@slate/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
