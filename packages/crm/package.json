{
  "name": "@slate/crm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CrmProvider port + the HubSpot adapter. Open core and vendor-named by ADR 0001 (R15 governs calendar vendors only). Pure HTTP: no DB, no encryption key.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./mapping": { "types": "./dist/mapping.d.ts", "import": "./dist/mapping.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slate/types": "workspace:*"
  },
  "devDependencies": {
    "@slate/config": "workspace:*",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
