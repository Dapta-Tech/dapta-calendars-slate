{
  "name": "@slate/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure scheduling engine — availability→slots, DST-safe timezone projection, round-robin host selection, manage tokens. No DB, no I/O.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@slate/config": "workspace:*",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
