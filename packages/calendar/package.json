{
  "name": "@slate/calendar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CalendarProvider port — the boundary to external calendars (busy times + event write/delete). Generic; the OSS default is disabled (no vendor named).",
  "license": "MIT",
  "main": "./dist/index.js",
