{
  "name": "@slate/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle data layer — one portable schema over SQLite (dev) and Postgres (prod), migrations, seed, and the booking repository.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "reset": "tsx src/cli/reset.ts"
  },
  "dependencies": {
    "@slate/calendar": "workspace:*",
    "@slate/engine": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@slate/config": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
