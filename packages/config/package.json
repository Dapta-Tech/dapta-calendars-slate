{
  "name": "@slate/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared config: zod env schema + tsconfig/eslint/prettier presets.",
  "main": "./dist/env.js",
  "types": "./dist/env.d.ts",
  "exports": {
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    },
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nest.json": "./tsconfig/nest.json",
    "./tsconfig/next.json": "./tsconfig/next.json",
    "./eslint": "./eslint.config.js",
    "./prettier": "./prettier.config.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "echo \"(config) no lint\"",
    "test": "echo \"(config) no tests\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
