# ---------------------------------------------------------------------------
# Calendars — example environment
# Copy to .env and adjust. A bare clone runs with NOTHING set here:
# SQLite file DB, log-only email, local dev auth. Zero infrastructure needed.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Unset  -> SQLite at ./.data/dev.db (the default, zero-infra clone-and-run)
# file:… -> SQLite file
# A PostgreSQL connection URL selects Postgres in production. Keep credentials in `.env`.
# DATABASE_URL=file:./.data/dev.db
# DATABASE_URL=

# --- API server -----------------------------------------------------------
# Port the NestJS API listens on (default 4000).
API_PORT=4000
# How long (ms) the API keeps an idle keep-alive connection open (default
# 65000, at most 86400000). Keep it above your load balancer's idle timeout
# (60 s on AWS ALB): if the server closes first, the balancer can reuse the
# closing socket and answer with a 502. The web app's standalone server reads
# the same variable, but only when set (Node's 5 s otherwise), so behind a load
# balancer set it for the web too.
# KEEP_ALIVE_TIMEOUT=65000
# Public base URL of the web app, used to build manage/booking links.
PUBLIC_APP_URL=http://localhost:3000

# --- Web app --------------------------------------------------------------
# The web's built-in API address, used when API_URL below is unset. Inlined when
# the web is built (a Docker build arg for the image), so changing it later does
# nothing. No browser code calls the API directly. Default: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where the web server reaches the API (server-rendered pages, server actions,
# sign-in), read at runtime. Unset -> NEXT_PUBLIC_API_URL above. Set it whenever
# the web server cannot reach the API there: in a container `localhost` is the
# web itself (docker-compose.prod.yml uses http://api:4000).
# API_URL=http://localhost:4000

# Search engines. Set (1|true|yes) to mark the WHOLE deployment noindex: an
# X-Robots-Tag header on every page and route response (build assets under
# /_next and the icons excepted), a robots meta tag on every page, and a
# robots.txt that disallows everything. For staging and preview copies. Unset
# (the default), robots.txt keeps crawlers out of /admin, /login, /onboarding
# and /api and leaves the booking pages open. Read at request time, so one
# image serves both.
# NOINDEX=1

# Public addresses shown on the admin's MCP pages. Read by the WEB server at
# RUNTIME (never NEXT_PUBLIC_*, which Next inlines at build time). Unset on a bare
# clone = the local API; unset in production = the page says it is not configured.
# MCP_PUBLIC_URL=https://calendar.your-domain.example/mcp
# API_PUBLIC_URL=https://api.your-domain.example
# The connector's page in Claude's connectors directory (a https://claude.ai/
# address), once a listing connects to MCP_PUBLIC_URL: the "Connect your agent"
# page then starts Claude's tab there. Unset = Claude's tab walks through a
# custom connector.
# MCP_CLAUDE_DIRECTORY_URL=https://claude.ai/directory/your-connector
# The API reads API_PUBLIC_URL too: it names this address in /openapi.json
# `servers` and the /docs examples. Unset there = both stay relative to wherever
# the API is served.

# Where the admin sidebar's "Docs" item points (new tab), per language: DOCS_URL
# for every language, DOCS_URL_ES (one DOCS_URL_<LOCALE> per language) to send
# Spanish readers somewhere else. Read by the WEB server at RUNTIME. Unset (the
# bare-fork default) = no Docs item: a fork is not sent to someone else's docs.
# DOCS_URL=https://docs.your-domain.example/
# DOCS_URL_ES=https://docs.your-domain.example/es/

# The web mirrors the API's AUTH_PROVIDER to pick the right login UX (email form
# vs WorkOS redirect). Same values as the API's AUTH_PROVIDER. Unset -> local.
# AUTH_PROVIDER=local
#
# Signs/verifies the httpOnly `slate_session` cookie (server-only — never
# NEXT_PUBLIC_*). Unset in a bare fork = unsigned dev cookie; SET it for any
# real deployment so the session can't be forged.
# WEB_SESSION_SECRET=replace-with-a-long-random-string
#
# API and web, same value (min 32 chars). The booking pages call the API from
# the web server; with this set on both, the web sends the visitor's address
# beside it and the API's rate limiter counts each visitor instead of the web
# server. Unset = every visitor shares the web server's bucket. The web sends
# it only to an API named by API_URL (never the NEXT_PUBLIC_API_URL fallback).
# INTERNAL_API_SECRET=replace-with-a-long-random-string
#
# WorkOS provider only: base URL of the upstream IAM identity service that fronts
# WorkOS AuthKit and mints the platform JWT. The web calls it for the login URL,
# and redirects through its logout. Server-only; never a secret itself.
# IAM_BASE_URL=https://iam.example.internal
#
# Email domain of YOUR OWN staff, if you run this for other people's accounts.
# Read by both the API and the web, and it buys two things, both of them for the
# person you send in to set a customer up:
#   - arriving in a customer's account provisions them as `admin` rather than
#     `member`, so they can see what is there instead of an empty account;
#   - the admin sidebar offers an account picker, so they can get to that
#     customer without signing out.
#
# A switch is still the identity service's call on every attempt, so this only
# decides what is offered. Unset in a bare fork, which is the right default: no
# domain is special and nobody is let in. Setting it asserts that your identity
# service will not mint a token for an address at this domain you do not control.
# OPERATOR_EMAIL_DOMAIN=@your-company.example

# --- Growth loop / branding (public pages) ---------------------------------
# When a signup destination is configured, public pages carry a discreet
# "Made with dCal.ai by Dapta" footer badge and a secondary signup line on the
# booking-confirmed screen. Open-core: unset (the bare-fork default) renders
# neither — no upstream branding is forced on forks; the upstream cloud
# deployment sets its own signup URL.
# NEXT_PUBLIC_SIGNUP_URL=https://app.your-cloud.example
#
# Where your Forms sidecar lives, if you run one (build time). The dashboard's
# app switcher links to it in a new tab; unset, it lists Forms as "Coming soon"
# (and the switcher shows only when this or NEXT_PUBLIC_PLATFORM_URL is set).
# NEXT_PUBLIC_FORMS_URL=https://forms.your-cloud.example
#
# Every badge/CTA link carries the UTM scheme
#   utm_source=dapta-calendars
#   utm_medium=badge | confirmation | profile | email   (which surface was clicked)
#   utm_campaign=made-with-dapta
#   utm_content=<accountCode>              (attribution only — already public in the page URL)
#
# Set to hide badge + CTA even when a signup URL is configured (1|true|yes).
# NEXT_PUBLIC_HIDE_BADGE=1
#
# The API reads the same switch for the invitee's booking emails ("Made with
# ... Create your free calendar" in the footer). It falls back to the two
# NEXT_PUBLIC_ values above, so set these only when the API's env differs.
# SIGNUP_URL=https://app.your-cloud.example
# HIDE_BADGE=1

# --- Booking pages on a host of their own ----------------------------------
# Where public booking pages live when they have a host of their own (cloud:
# https://book.<domain>), apart from PUBLIC_APP_URL. Same value on the web and
# the API. Set it only together with that host: it also stops the web reading
# the session cookie's pre-__Host- name. See SELF-HOSTING.md.
# PUBLIC_BOOKING_URL=

# --- Tracking and pixels per event type -----------------------------------
# Meta Pixel and PostHog need nothing here: every workspace's owners and
# admins can set them. Google Tag Manager, Google Analytics 4 and HubSpot can
# run code set up in the host's own account on this origin, next to the
# dashboard's session, so they load only for the workspaces listed: account short codes or vanity
# slugs, comma-separated, or `*` for all. Unset = nobody. Name only workspaces
# you trust. See SELF-HOSTING.md.
# EVENT_TRACKING_ACCOUNTS=

# --- Email / notifications ------------------------------------------------
# Provider selector. Unset or "log-only" -> emails are logged, not sent
# (a bare fork still runs booking flows end-to-end).
#   log-only | noop | smtp | http
EMAIL_PROVIDER=log-only
MAIL_FROM_EMAIL=bookings@example.com
MAIL_FROM_NAME=Calendars
# The support address booking emails name in their footer ("Need help? ...").
# Unset -> no support line at all.
# MAIL_SUPPORT_EMAIL=support@example.com

# SMTP adapter (EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# HTTP mailer adapter (EMAIL_PROVIDER=http) — POSTs each message to an external
# email service. Wire it to any send endpoint; no provider is hardcoded.
# EMAIL_HTTP_ENDPOINT=https://email.example.com/api/send
#
# Wire/profile:
#   generic          — provider-agnostic JSON body + optional Bearer auth (default)
#   transactional-v1 — managed transactional contract + HMAC service auth
# EMAIL_HTTP_PROFILE=generic
# transactional-v1 requires the endpoint path `/api/internal/email/send`.
#
# generic profile: Bearer token.
# EMAIL_HTTP_TOKEN=
#
# transactional-v1 profile: a stable client id plus a server-only signing
# secret loaded from the deployment secret manager. The secret is never sent.
# EMAIL_HTTP_CLIENT_ID=calendars
# EMAIL_HTTP_SIGNING_SECRET=
# EMAIL_HTTP_CATEGORY=lifecycle

# --- Auth (dashboard only; public booking pages are always open) ----------
# Unset -> local dev auth stub (a fork logs in without any external provider).
# AUTH_PROVIDER=local
#
# DEV ONLY: with AUTH_PROVIDER=local, log in as a specific email instead of the
# first seeded demo account. The stub resolves the member with this email and
# JIT-creates a fresh account+member if none exists. (A request may also carry
# `x-slate-email`, which overrides this.) Ignored in production.
# DEV_LOGIN_EMAIL=you@example.com
#
# DEV ONLY: strict local auth. When true, a request with no identity (no
# impersonation headers, no x-slate-email) returns 401 instead of falling back
# to the seeded account — giving local dev a real "logged out" state so the web
# login/logout flow can bounce to sign-in. Default false = always logged in.
# AUTH_LOCAL_STRICT=false
#
# AUTH_PROVIDER=workos validates a host session token minted by an upstream
# identity service: an HS256 JWT (claims: sub, account_id, email, name) signed
# with a shared secret. The SAME validation runs in local dev and remote because
# the secret is symmetric — nothing environment-specific to fetch. Selecting
# `workos` without JWT_SECRET fails loud (never falls back to the insecure stub).
# JWT_ISSUER / JWT_AUDIENCE are enforced only when set.
# AUTH_PROVIDER=workos
# JWT_SECRET=replace-with-your-shared-signing-secret
# JWT_ISSUER=your-identity-issuer
# JWT_AUDIENCE=your-platform-audience
#
# Offline dev: mint a token that this provider will accept (no identity server):
#   pnpm --filter @slate/api auth:mint -- --account acct_dev --sub user_dev
# then call the API with `Authorization: Bearer <token>`.

# --- Calendar (external free-busy + event write-out) ----------------------
# disabled (default) -> no external calendar: slots subtract only local busy and
# no events are written out (clone-and-run needs nothing here). `external`
# selects the generic-HTTP ExternalCalendarProvider.
# CALENDAR_PROVIDER=disabled
#
# external needs a backend. Two ways:
#  (a) Self-host / any REST calendar service implementing the /v1 contract:
#      set the base URL + a static bearer; the committed GenericRestWire is used.
# CALENDAR_PROVIDER=external
# CALENDAR_API_BASE_URL=https://your-calendar-service.example
# CALENDAR_API_TOKEN=replace-with-a-bearer-token
#  (b) A real integration platform: point at a PRIVATE overlay module (gitignored,
#      e.g. under deploy/) that supplies the JWT authority + vendor request mapping.
#      The base URL / signing secret stay in this .env or deploy config — never here.
# CALENDAR_PROVIDER=external
# CALENDAR_BACKEND_MODULE=/abs/path/to/deploy/calendar/backend.js
# CALENDAR_HTTP_TIMEOUT_MS=30000
# Busy requests per second one API process may start for one host (the backend
# limit is per host across every replica: give each replica its share).
# CALENDAR_BUSY_REQUESTS_PER_SECOND=4
# Longest span of one busy request, in days (1 to 90). Raise it above 14 ONLY
# when the calendar adapter reads busy times from a free/busy query; with an
# events listing a long window comes back short on a full calendar.
# CALENDAR_BUSY_WINDOW_DAYS=14
# The booking, team and manage pages read busy times through a short cache, per
# calendar (ADR 0009). Holds, bookings, reschedules and confirmations always read
# the calendar fresh. All optional; 0 for the TTL turns the cache off.
# CALENDAR_BUSY_CACHE_TTL_MS=30000
# When a fresh read fails or is slow, how old the last good read may be and
# still stand in; older, the page says the calendar can't be read right now.
# CALENDAR_BUSY_CACHE_MAX_STALE_MS=300000
# CALENDAR_BUSY_CACHE_MAX_ENTRIES=1000
# How long a page waits on a slow calendar before answering without it.
# CALENDAR_BUSY_READ_TIMEOUT_MS=10000

#
# Display name for the conferencing your backend mints, shown to hosts choosing
# the "online meeting" location kind. This repo names no conferencing platform;
# your deployment does. Unset -> hosts see generic wording, which is correct for
# a build with no conferencing behind it.
# CALENDAR_CONFERENCING_LABEL=Your Meeting Platform


# --- Onboarding cohort probe (first-run wizard) ---------------------------
# UNSET (the default) means the qualification gate does not apply at all: those
# questions feed a growth funnel, and with no upstream there is no funnel, so a
# bare fork's first admin goes straight to the dashboard. The per-host setup
# step still runs (it creates your first event type) and has a skip.
#
# Configured, the identity service is asked whether this signup is already a
# known identity: a hit selects the short cohort, a definitive 404 the full one.
# Any error or timeout FAILS CLOSED to the short cohort - an upstream blip must
# never widen the interrogation. Placeholder host only, never a real one.
# ONBOARDING_IAM_BASE_URL=https://your-identity-service.example
# ONBOARDING_IAM_TOKEN=replace-with-a-bearer-token
# ONBOARDING_PROBE_TIMEOUT_MS=1500

# --- Growth contact sync (optional; unset = nothing is ever sent) ------------
#
# Where a new signup's contact is pushed, so the people running the deployment
# can see who arrived and where from. This is the operator's OWN marketing CRM,
# not the customer-facing CRM integration your hosts connect to their own
# accounts - different system, different purpose.
#
# UNSET (the default, and the only sensible value for a fork) sends nothing at
# all. The rows are still enqueued and the worker records them as skipped with a
# reason, so nothing accumulates as failures and the delivery log stays honest.
#
# Attribution itself needs no configuration: campaign parameters are captured
# from the URL, normalized against a fixed seven-key allowlist, and claimed
# write-once onto an account in its first ten minutes. Organic traffic records
# nothing rather than a synthetic "direct".
#
# The lead-score post reuses ONBOARDING_IAM_BASE_URL above - one upstream, one
# pair of credentials. Placeholder host only, never a real one.
# DAPTA_SYNC_URL=https://your-crm-webhook.example/contacts
# DAPTA_SYNC_TOKEN=replace-with-a-bearer-token
# DAPTA_SYNC_TIMEOUT_MS=5000

# --- Product analytics (optional; unset = no script, no event, no request) ---
#
# The deployment's OWN telemetry: how hosts use the product, and anonymous
# counts of the booking funnel on public pages. Visitors are never identified
# and nothing they type is sent; see ANALYTICS.md for every event.
#
# Read at REQUEST time by the web app (not NEXT_PUBLIC_*, so not baked into the
# image) and at boot by the API. Set the same names on both. `posthog` is the
# one adapter shipped; the key is the project's write-only ingestion key.
# Placeholder values only, never a real key or host.
# PRODUCT_ANALYTICS_PROVIDER=posthog
# PRODUCT_ANALYTICS_KEY=phc_replace_with_your_project_key
# PRODUCT_ANALYTICS_HOST=https://analytics-proxy.your-domain.example
# Marks your own staff and test accounts `is_internal` (comma-separated,
# case-insensitive substrings of an email).
# PRODUCT_ANALYTICS_INTERNAL_EMAILS=@your-company.example
# Error tracking rides the same project: on whenever analytics is on, scrubbed
# before it leaves (see SELF-HOSTING.md, "Error tracking"). `off` stops error
# capture only.
# PRODUCT_ANALYTICS_ERRORS=off
# Build time, web image only: `1` emits browser source maps for upload. The
# web Dockerfile deletes them before the image is assembled; any other build
# serves them from /_next/static unless its own pipeline deletes them.
# PRODUCT_ANALYTICS_SOURCEMAPS=1

# --- CRM write-out (optional; unset = nothing is ever sent) ------------------
#
# Writes an accepted booking into the CRM your hosts already work in: the
# invitee becomes a contact (an existing one keeps its own name), and the
# booking becomes a meeting associated to that contact. Cancelling or
# rescheduling updates that same meeting. This is the CUSTOMER-facing
# integration a workspace connects to its own portal - not the operator's own
# marketing sync above. Different system, different purpose.
#
# `disabled` (the default) means nothing is enqueued and nothing is called.
# Naming the vendor here is deliberate and allowed - see
# docs/adr/0001-crm-integrations-are-open-core-and-name-their-vendor.md. The
# vendor-neutral rule applies to CALENDAR providers only.
# CRM_PROVIDER=hubspot
# CRM_HTTP_TIMEOUT_MS=10000
#
# Where the adapter sends its requests. Defaults to the vendor's own public
# host, so leave it alone unless your egress runs through a proxy or you are
# pointing the integration at a stub to exercise it end to end.
# CRM_API_BASE_URL=https://api.hubapi.com

# Encryption key for secrets at rest (AES-256-GCM), 32 raw bytes base64.
# Generate one with: openssl rand -base64 32
# Boot never reads it. It is needed to CONNECT a credential from the dashboard,
# and to CREATE a webhook - webhook signing secrets ride the same envelope.
# Either write without it is refused loudly rather than stored in plaintext.
# Webhooks that already exist with a plaintext secret keep delivering, and are
# re-encrypted in place the first time they sign once a key is set.
# INTEGRATION_ENCRYPTION_KEY=generate-your-own-with-openssl-rand-base64-32

# Zero-config fallback: ONE private-app token for the whole deployment, used
# only by accounts that have connected nothing of their own. A token connected
# in the dashboard always wins. Required scopes, and there are only two:
#   crm.objects.contacts.read
#   crm.objects.contacts.write
# Leaving this placeholder in place counts as UNSET - it is recognized and
# ignored, so an unfilled line disables the integration instead of failing every
# booking. Placeholder only, never a real token.
# HUBSPOT_PRIVATE_APP_TOKEN=replace-with-your-private-app-token

# --- Outbox (emails, calendar writes, webhooks: delivered with retries) -----
# All optional. Each kind of work drains on its own, a booking's deliveries go
# one at a time in the order queued, a slow webhook subscriber holds at most one
# slot per process, and several API replicas may all run the worker (rows are
# claimed with a lease).
# OUTBOX_WORKER_ENABLED=true
# OUTBOX_POLL_MS=5000
# How long a failing delivery keeps being retried, from its first failure
# (backoff 1 s, 2 s, 4 s ... capped at 15 min). 0 = give up after five attempts.
# OUTBOX_RETRY_HORIZON_MS=86400000
# OUTBOX_CONCURRENCY=4
# OUTBOX_LEASE_MS=300000

# --- OAuth for the MCP endpoint (optional; unset = off) -----------------------
# The API as its own OAuth 2.1 authorization server, so Claude, ChatGPT, Cursor
# and VS Code connect to /mcp with a sign-in and a consent screen instead of a
# pasted API key. People sign in through AUTH_PROVIDER; nothing is registered
# with any identity vendor. Turning it on REQUIRES MCP_PUBLIC_URL (above, it
# becomes the token audience), OAUTH_ISSUER and OAUTH_SIGNING_JWK; the API
# refuses to boot without them. See SELF-HOSTING.md and docs/MCP.md.
# OAUTH_ENABLED=false
# The public origin serving /oauth/* and /.well-known/oauth-authorization-server.
# OAUTH_ISSUER=https://calendar.your-domain.example
# One EC P-256 PRIVATE JWK as JSON (a secret). Generate one with:
#   node -e "const {generateKeyPairSync}=require('node:crypto');console.log(JSON.stringify(generateKeyPairSync('ec',{namedCurve:'P-256'}).privateKey.export({format:'jwk'})))"
# OAUTH_SIGNING_JWK=
# OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# OAUTH_GRANT_TTL_DAYS=90
# OAUTH_REFRESH_REUSE_GRACE_SECONDS=10
# OAUTH_CIMD_ENABLED=true
# OAUTH_DCR_ENABLED=true
# OAUTH_DCR_EXTRA_REDIRECT_URIS=
#
# Or sign people in through an EXTERNAL OAuth 2.1 authorization server (RFC 8707
# resource indicators, RS256/ES256 tokens, a JWKS): set its issuer here and the
# API is a resource server only; OAUTH_ISSUER and OAUTH_SIGNING_JWK are then not
# needed. Your AUTH_PROVIDER must record that server's user id on the member.
# OAUTH_AUTHORIZATION_SERVER=https://auth.your-domain.example
# OAUTH_JWKS_URL=
# Days after the identity service last vouched for a person in an account (the
# issue time of their last web login's token) that a sign-in may still act
# there (removal upstream is never reported here). Match the session lifetime.
# OAUTH_LINK_MAX_AGE_DAYS=30
