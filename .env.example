# ---------------------------------------------------------------------------
# Calendars — example environment
# Copy to .env and adjust. A bare clone runs with NOTHING set here:
# SQLite file DB, log-only email, local dev auth. Zero infrastructure needed.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Unset  -> SQLite at ./.data/dev.db (the default, zero-infra clone-and-run)
# file:… -> SQLite file
# postgres://user:pass@host:5432/dbname -> Postgres (production)
# DATABASE_URL=file:./.data/dev.db
# DATABASE_URL=postgres://calendars:calendars@localhost:5432/calendars

# --- API server -----------------------------------------------------------
# Port the NestJS API listens on (default 4000).
API_PORT=4000
# Public base URL of the web app, used to build manage/booking links.
PUBLIC_APP_URL=http://localhost:3000

# --- Web app --------------------------------------------------------------
# Where the web app reaches the API from the server (RSC fetch). Default:
# http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# The web mirrors the API's AUTH_PROVIDER to pick the right login UX (email form
# vs WorkOS redirect). Same values as the API's AUTH_PROVIDER. Unset -> local.
# AUTH_PROVIDER=local
#
# Signs/verifies the httpOnly `slate_session` cookie (server-only — never
# NEXT_PUBLIC_*). Unset in a bare fork = unsigned dev cookie; SET it for any
# real deployment so the session can't be forged.
# WEB_SESSION_SECRET=replace-with-a-long-random-string
#
# WorkOS provider only: base URL of the upstream IAM identity service that fronts
# WorkOS AuthKit and mints the platform JWT. The web calls it for the login URL,
# and redirects through its logout. Server-only; never a secret itself.
# IAM_BASE_URL=https://iam.example.internal

# --- Email / notifications ------------------------------------------------
# Provider selector. Unset or "log-only" -> emails are logged, not sent
# (a bare fork still runs booking flows end-to-end).
#   log-only | noop | smtp | http
EMAIL_PROVIDER=log-only
MAIL_FROM_EMAIL=bookings@example.com
MAIL_FROM_NAME=Calendars

# SMTP adapter (EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Generic HTTP mailer adapter (EMAIL_PROVIDER=http) — POSTs the message to an
# external email service. Provider-agnostic; wire it to any send endpoint.
# EMAIL_HTTP_ENDPOINT=https://email.example.com/api/send
# EMAIL_HTTP_TOKEN=

# --- Auth (dashboard only; public booking pages are always open) ----------
# Unset -> local dev auth stub (a fork logs in without any external provider).
# AUTH_PROVIDER=local
#
# DEV ONLY: with AUTH_PROVIDER=local, log in as a specific email instead of the
# first seeded demo account. The stub resolves the member with this email and
# JIT-creates a fresh account+member if none exists. (A request may also carry
# `x-slate-email`, which overrides this.) Ignored in production.
# DEV_LOGIN_EMAIL=you@example.com
#
# DEV ONLY: strict local auth. When true, a request with no identity (no
# impersonation headers, no x-slate-email) returns 401 instead of falling back
# to the seeded account — giving local dev a real "logged out" state so the web
# login/logout flow can bounce to sign-in. Default false = always logged in.
# AUTH_LOCAL_STRICT=false
#
# AUTH_PROVIDER=workos validates a host session token minted by an upstream
# identity service: an HS256 JWT (claims: sub, account_id, email, name) signed
# with a shared secret. The SAME validation runs in local dev and remote because
# the secret is symmetric — nothing environment-specific to fetch. Selecting
# `workos` without JWT_SECRET fails loud (never falls back to the insecure stub).
# JWT_ISSUER / JWT_AUDIENCE are enforced only when set.
# AUTH_PROVIDER=workos
# JWT_SECRET=replace-with-your-shared-signing-secret
# JWT_ISSUER=your-identity-issuer
# JWT_AUDIENCE=your-platform-audience
#
# Offline dev: mint a token that this provider will accept (no identity server):
#   pnpm --filter @slate/api auth:mint -- --account acct_dev --sub user_dev
# then call the API with `Authorization: Bearer <token>`.

# --- Calendar (external free-busy + event write-out) ----------------------
# disabled (default) -> no external calendar: slots subtract only local busy and
# no events are written out (clone-and-run needs nothing here). `external`
# selects the concrete adapter from the private deploy/ overlay.
# CALENDAR_PROVIDER=disabled
