{
  "name": "slate",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source scheduling & booking platform — clone-and-run on SQLite, deploy anywhere.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm run build:packages && pnpm run db:setup && turbo run dev",
    "dev:pg": "docker compose up -d --wait db && cross-env DATABASE_URL=postgres://slate:slate@localhost:${PG_PORT:-5432}/slate pnpm run db:setup && cross-env DATABASE_URL=postgres://slate:slate@localhost:${PG_PORT:-5432}/slate turbo run dev",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @slate/db migrate",
    "db:seed": "pnpm --filter @slate/db seed",
    "db:reset": "pnpm --filter @slate/db reset",
    "db:setup": "pnpm run db:migrate && pnpm run db:seed",
    "changeset": "changeset",
    "glyph-gate": "node scripts/glyph-gate.mjs",
    "spacing-gate": "node scripts/spacing-gate.mjs",
    "publish-gate": "bash scripts/publish-gate.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@vitest/coverage-v8": "2.1.9",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.10",
    "turbo": "2.11.9",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ]
  }
}
