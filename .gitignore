# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Regenerated by Next on every dev/build run, and rewritten depending on WHICH
# of the two ran last — it flips its routes import between .next/types and
# .next/dev/types. Committed, that means an unrelated PR carries a one-line
# generated diff whenever someone booted the dev server, and two concurrent
# worktrees flip it against each other. Next documents it as generated and not
# to be edited. The stable half of what it declared is committed by hand at
# apps/web/types/next-globals.d.ts; the half that churns is the .next import,
# which nothing in this app uses.
apps/web/next-env.d.ts

# Turbo
.turbo/

# Local database (SQLite) & data
.data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Environment & secrets — NEVER commit real env or keys
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# Internal deploy overlay — private, never in the public repo
/deploy/

