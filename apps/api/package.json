{
  "name": "@slate/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Slate API — NestJS booking/availability service over @slate/engine + @slate/db.",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "auth:mint": "tsx src/cli/mint-token.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "e2e:mcp": "tsx scripts/mcp-e2e.mjs",
    "e2e:oauth": "tsx scripts/oauth-e2e.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@slate/calendar": "workspace:*",
    "@slate/config": "workspace:*",
    "@slate/crm": "workspace:*",
    "@slate/db": "workspace:*",
    "@slate/engine": "workspace:*",
    "@slate/notifications": "workspace:*",
    "@slate/shared": "workspace:*",
    "@slate/types": "workspace:*",
    "express": "4.22.1",
    "jose": "^6.2.12",
    "oidc-provider": "9.12.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1",
    "zod4": "npm:zod@^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/oidc-provider": "^9.12.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
